{
  "name": "frontend",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n 'user,owner' -c '#007755,#550077' 'bun user' 'bun owner'",
    "user": "cd apps/user && bun dev",
    "owner": "cd apps/owner && bun dev",
    "storybook": "concurrently -n 'user,owner' -c 'cyan,magenta' \"cd apps/user && bun run storybook\" \"cd apps/owner && bun run storybook\"",
    "storybook:user": "cd apps/user && bun run storybook",
    "storybook:owner": "cd apps/owner && bun run storybook",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "build": "cd packages/common && bun run build && bun run --filter './apps/*' build"
  },
  "devDependencies": {
    "@types/bun": "^1.2.19",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "concurrently": "^6.2.0",
    "eslint": "^9.31.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "^5.8.3"
  }
}
