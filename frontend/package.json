{
  "name": "frontend",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n 'customer,owner' -c '#007755,#550077' 'bun customer' 'bun owner'",
    "customer": "cd apps/customer && bun dev",
    "owner": "cd apps/owner && bun dev",
    "storybook": "concurrently -n 'customer,owner' -c 'cyan,magenta' \"cd apps/customer && bun run storybook\" \"cd apps/owner && bun run storybook\"",
    "storybook:customer": "cd apps/customer && bun run storybook",
    "storybook:owner": "cd apps/owner && bun run storybook",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css}\"",
    "build:common": "cd packages/common && bun run build",
    "build:customer": "cd apps/customer && bun run build",
    "build:owner": "cd apps/owner && bun run build",
    "build": "bun run build:common && bun run build:customer && bun run build:owner"
  },
  "dependencies": {
    "@sentry/react": "^9.40.0",
    "@tanstack/react-query": "^5.83.0",
    "@tosspayments/payment-sdk": "^1.9.1",
    "axios": "^1.11.0",
    "firebase": "^12.1.0",
    "lucide-react": "^0.525.0",
    "openvidu-browser": "^2.31.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-router-dom": "^7.7.0",
    "simplebar": "^6.3.2",
    "simplebar-react": "^3.3.2",
    "vite-plugin-pwa": "^1.0.2",
    "workbox-window": "^7.3.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.0.1",
    "@storybook/addon-a11y": "^9.0.18",
    "@storybook/addon-docs": "^9.0.18",
    "@storybook/addon-onboarding": "^9.0.18",
    "@storybook/react-vite": "^9.0.18",
    "@tanstack/react-query-devtools": "^5.83.0",
    "@types/bun": "^1.2.19",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "9.0.18",
    "globals": "^16.3.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "storybook": "^9.0.18",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.4",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
